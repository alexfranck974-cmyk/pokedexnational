{
  "expo": {
    "name": "Pokedexnational",
    "slug": "Pokedexnational",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pokedexnational",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexfranck974.pokedexnational"
    },
    "android": {
      "package": "com.alexfranck974.pokedexnational",
      "adaptiveIcon": {
        "backgroundColor": "#faf5f1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6139655d-c699-4990-89ac-e0ebf59e0a00"
      }
    },
    "owner": "alexfranck",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6139655d-c699-4990-89ac-e0ebf59e0a00"
    }
  }
}
